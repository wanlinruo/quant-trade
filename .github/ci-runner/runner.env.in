QSYS_CI_REPOSITORY=@@REPOSITORY@@
QSYS_CI_RUNNER_GROUP=@@RUNNER_GROUP@@
QSYS_CI_RUNNER_UID=@@RUNNER_UID@@
QSYS_CI_RUNNER_GID=@@RUNNER_GID@@
QSYS_CI_STATE_DIR=/var/lib/qsys-ci-runner
QSYS_CI_IMAGE_ID_FILE=/etc/qsys/ci-runner/image-id
QSYS_CI_TOKEN_FILE=/etc/qsys/ci-runner/github-token
QSYS_CI_ENABLE_FILE=/etc/qsys/ci-runner/enabled

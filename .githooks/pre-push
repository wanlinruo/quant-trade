#!/bin/sh
set -eu

# GitHub Free 私有仓库没有服务端保护分支。本 hook 是 Mac 开发机的第一道硬门禁：
# main 只能由 GitHub PR 合并产生；test 是日常集成分支，允许直接 push。
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main)
            echo "拒绝直接推送 main；请先更新 test，再创建 test -> main PR。" >&2
            exit 1
            ;;
    esac
done

# #600：推送前扫描密钥与资金账户号。真实账户号只放在仓库外的私有文件中，
# 由 check_secrets.py 精确匹配且不回显；文件不存在时只执行上下文规则。
: "${QSYS_FORBIDDEN_ACCOUNT_IDS_FILE:=$HOME/.config/qsys/forbidden-account-ids}"
export QSYS_FORBIDDEN_ACCOUNT_IDS_FILE
python3 scripts/check_secrets.py >&2

exit 0

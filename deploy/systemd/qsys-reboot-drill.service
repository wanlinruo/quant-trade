[Unit]
Description=qsys monthly reboot drill baseline (dry-run, no automatic reboot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/qsys
ExecStart=/home/ubuntu/qsys/.venv/bin/python -u scripts/reboot_drill.py \
          --dry-run \
          --config config/deploy.local.toml \
          --service-runs /home/ubuntu/qsys/var/service-runs
# 定时入口只采真实基线；实际重启另需当次日期/主机审批及显式 --execute。
# 保留人工演练的等待预算；--dry-run 不执行重启或恢复等待。
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# 只写运行记录与告警流水；要读 SSH 私钥去登 Windows
ReadWritePaths=/home/ubuntu/qsys/var

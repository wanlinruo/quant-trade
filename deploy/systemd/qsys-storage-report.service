[Unit]
Description=qsys daily inode-deduplicated storage capacity snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/qsys
ExecStart=/home/ubuntu/qsys/.venv/bin/python -u scripts/storage_report.py \
          --base /data/qsys \
          --scratch /home/ubuntu/scratch \
          --history-root /home/ubuntu/qsys/var/storage-history
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/qsys/var

[Install]
WantedBy=multi-user.target

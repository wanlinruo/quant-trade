[Unit]
Description=qsys catalog verification (incremental + year-to-date full rules)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/data/qsys/catalog-verify-state
ExecStart=/usr/bin/flock --exclusive --nonblock /home/ubuntu/qsys/var/warehouse-write.lock \
          /home/ubuntu/qsys/.venv/bin/python -u /home/ubuntu/qsys/scripts/catalog_verify.py \
          --warehouse /data/qsys/warehouse --config /home/ubuntu/qsys/config/deploy.local.toml \
          --service-runs /home/ubuntu/qsys/var/service-runs
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=idle
MemoryMax=3G
MemorySwapMax=512M
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# 写 metric_checks（warehouse 是指向数据盘的软链接）、样本 artifacts/ 与 C4 冻结基线。
ReadWritePaths=/home/ubuntu/qsys /data/qsys

[Install]
WantedBy=multi-user.target

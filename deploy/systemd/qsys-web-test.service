[Unit]
Description=qsys test web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/qsys-test
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/ubuntu/qsys-test/.venv/bin/python scripts/run_monitor.py \
          --host 127.0.0.1 \
          --port 8421 \
          --warehouse /data/qsys-test/warehouse-current \
          --workspace /data/qsys-test/var/workbench \
          --state /data/qsys-test/var/shadow-state.sqlite3 \
          --runs /data/qsys-test/var/runs \
          --service-runs /data/qsys-test/var/service-runs \
          --tushare-config /data/qsys-test/var/tushare-only.toml
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/data/qsys-test/warehouse-current
ReadWritePaths=/data/qsys-test/var

[Install]
WantedBy=multi-user.target

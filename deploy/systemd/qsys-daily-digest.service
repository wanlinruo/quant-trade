[Unit]
Description=qsys daily operations digest (email)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/qsys
ExecStart=/home/ubuntu/qsys/.venv/bin/python -u scripts/send_daily_digest.py \
          --config config/deploy.local.toml \
          --service-runs /home/ubuntu/qsys/var/service-runs \
          --shadow-state /home/ubuntu/qsys/var/shadow-state.sqlite3 \
          --workbench /home/ubuntu/qsys/var/workbench/workbench.sqlite3 \
          --warehouse /home/ubuntu/qsys/warehouse \
          --storage-base /data/qsys \
          --tls-site wanlinruo.cn --tls-port 8443
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# 只读状态库与仓库，不写任何东西；发信走网络。
# --warehouse 不给的话「数据质量」段会判成「当日没有验证结果」，
# 交易日天天误报——参数是这一段的前提，不是可选项。
ReadWritePaths=/home/ubuntu/qsys/var

[Install]
WantedBy=multi-user.target

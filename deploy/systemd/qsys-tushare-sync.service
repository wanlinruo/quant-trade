[Unit]
Description=qsys Tushare daily incremental sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/qsys
ExecStart=/usr/bin/flock --exclusive --nonblock /home/ubuntu/qsys/var/warehouse-write.lock \
          /home/ubuntu/qsys/.venv/bin/python -u scripts/tushare_daily_sync.py --warehouse /home/ubuntu/qsys/warehouse
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/qsys /data/qsys

[Install]
WantedBy=multi-user.target

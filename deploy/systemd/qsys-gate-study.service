[Unit]
Description=qsys monthly ecology gate study (backtest + per-decision counterfactual)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/qsys
# 两步：先按当年至今跑一次开闸门回测（落在 var/runs，网页可见），
# 再对它的判定留痕做逐笔反事实。只读仓库，不取写锁。
ExecStart=/bin/sh -c '/usr/bin/nice /usr/bin/ionice -c3 /home/ubuntu/qsys/.venv/bin/python -u \
          scripts/run_structural_backtest.py --warehouse /home/ubuntu/qsys/warehouse \
          --start $(date +%%Y)-01-01 --end $(date -d "yesterday" +%%Y-%%m-%%d) \
          --entry-fill continuous --entry-price-buffer 0.03 --sizing-price-buffer 0.005 \
          --auction-at 09:25:10 \
          --out var/runs/研究-月度-gate-$(date +%%Y-%%m)/equity.csv \
          --runs-dir var/runs --run-name 研究-月度-gate-$(date +%%Y-%%m)'
ExecStart=/bin/sh -c '/usr/bin/nice /usr/bin/ionice -c3 /home/ubuntu/qsys/.venv/bin/python -u \
          scripts/gate_study.py --warehouse /home/ubuntu/qsys/warehouse \
          --decisions var/runs/研究-月度-gate-$(date +%%Y-%%m)/gate_decisions.csv \
          --service-runs var/service-runs \
          --out /data/qsys/research/gate/$(date +%%Y-%%m)'
TimeoutStartSec=3600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/qsys/var /data/qsys/research

[Install]
WantedBy=multi-user.target

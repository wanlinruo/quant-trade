[Unit]
Description=qsys service health observer (read-only probes and local timeline)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/qsys
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/qsys/.venv/bin/python scripts/run_health_observer.py \
          --config /home/ubuntu/qsys/config/deploy.local.toml \
          --state /home/ubuntu/qsys/var/service-health.sqlite3
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/qsys/var

[Install]
WantedBy=multi-user.target

[Unit]
Description=qsys daily archive (auction ticks, minute bars and validation)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/qsys
ExecStart=/usr/bin/flock --exclusive --nonblock /home/ubuntu/qsys/var/warehouse-write.lock \
          /home/ubuntu/qsys/.venv/bin/python -u scripts/daily_archive.py \
          --warehouse /home/ubuntu/qsys/warehouse --lookback-days 8 \
          --skip-capital
TimeoutStartSec=7200
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/qsys /data/qsys

[Install]
WantedBy=multi-user.target

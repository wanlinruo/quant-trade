[Unit]
Description=qsys daily service checks (arrival and counts per scheduled job)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/qsys
ExecStart=/home/ubuntu/qsys/.venv/bin/python -u scripts/service_checks.py --warehouse /home/ubuntu/qsys/warehouse
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# 运行记录、指标验证结果（warehouse/metric_checks）与样本（artifacts/）。
# warehouse 是指向数据盘的软链接，故两处都要放开；到货检查本身仍然只读。
ReadWritePaths=/home/ubuntu/qsys /data/qsys

[Install]
WantedBy=multi-user.target

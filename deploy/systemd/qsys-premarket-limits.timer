[Unit]
Description=Fetch today's Tushare stk_limit before the open

[Timer]
# Tushare stk_limit 约 09:00 更新当日涨跌停价；脚本每分钟重试到 09:25。
# 非交易日由脚本查 trade_cal 后直接退出。Persistent=true：节点在触发时刻
# 关机时开机补跑——盘中晚到的直取价仍对后续检查点有用。
OnCalendar=Mon..Fri 08:58 Asia/Shanghai
Persistent=true

[Install]
WantedBy=timers.target
